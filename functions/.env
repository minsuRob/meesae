# 배포 환경 파라미터 (firebase deploy 가 읽는다). 에뮬레이터는 .env.local 이 덮어쓴다.
# 콘솔에서 App Check(웹 reCAPTCHA Enterprise · App Attest · Play Integrity)를 등록하면 true 로 바꾼다
ENFORCE_APP_CHECK=false
# nominatim | google | fake
GEOCODER=nominatim
# GEOCODER=google 일 때만. 비밀값은 Secret Manager 로: firebase functions:secrets:set GOOGLE_GEOCODING_KEY
NOMINATIM_EMAIL=
