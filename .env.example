# Firebase 웹 앱 구성 (firebase apps:sdkconfig WEB). 공개 클라이언트 구성이라 비밀이 아니다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 1 이면 로컬 에뮬레이터(demo-meesae)에 붙는다. 개발용 로그인 버튼도 이때만 보인다.
EXPO_PUBLIC_USE_EMULATOR=1
# 실기기에서 에뮬레이터에 붙을 때 맥의 LAN IP (비우면 127.0.0.1 / 안드로이드 에뮬레이터는 10.0.2.2)
EXPO_PUBLIC_EMULATOR_HOST=

# 구글 로그인 (콘솔에서 Google 제공업체를 켠 뒤 생기는 "웹 클라이언트 ID")
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Check: 웹 reCAPTCHA Enterprise 사이트 키 (콘솔 App Check 등록 후)
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
# 개발 빌드용 App Check 디버그 토큰 (콘솔 > App Check > 디버그 토큰 관리)
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
